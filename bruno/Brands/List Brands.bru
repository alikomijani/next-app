meta {
  name: List Brands
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/brands
  body: none
  auth: none
}

params:query {
  page: {{page}}
  perPage: {{perPage}}
  search: {{search}}
}

docs {
  Lists active brands with pagination. Add `includeInactive=true` to include deactivated brands.
}
