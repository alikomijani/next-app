meta {
  name: Update Brand PUT
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/brands/{{brandId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "faName": "Updated Brand FA",
    "enName": "Updated Brand EN",
    "description": "Updated brand description",
    "slug": "{{brandSlug}}"
  }
}

docs {
  Updates brand fields with PUT.
}
