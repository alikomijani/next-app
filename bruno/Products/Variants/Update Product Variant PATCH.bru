meta {
  name: Update Product Variant PATCH
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/products/{{productId}}/variants/{{variantId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "color": "black",
    "size": "XL",
    "images": [
      "https://example.com/product-black-xl.jpg"
    ]
  }
}

docs {
  Updates one product variant with PATCH.
}
