meta {
  name: Upsert Product Attributes PUT
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/products/{{productId}}/attributes
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "attributes": [
      {
        "name": "material",
        "value": "cotton"
      },
      {
        "name": "origin",
        "value": "local"
      }
    ]
  }
}

docs {
  Upserts product attributes. Attribute `name` is unique per product.
}
