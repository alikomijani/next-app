meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/refresh-token
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

docs {
  Refreshes access and refresh tokens. If the body token is empty, the route can use the `refreshToken` cookie.
}
