meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "firstName": "Demo",
    "lastName": "User"
  }
}

docs {
  Creates a user and returns the public user object.
}
