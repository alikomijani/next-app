meta {
  name: Update Password PATCH
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "new-password123"
  }
}

docs {
  Updates the current user's password with PATCH.
}
