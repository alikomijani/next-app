meta {
  name: Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "faName": "Category FA",
    "enName": "Category EN",
    "description": "Category description",
    "slug": "{{categorySlug}}"
  }
}

docs {
  Creates a category. `slug` is unique.
}
