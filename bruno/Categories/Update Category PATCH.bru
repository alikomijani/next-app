meta {
  name: Update Category PATCH
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "faName": "Updated Category FA",
    "enName": "Updated Category EN",
    "description": "Updated category description",
    "slug": "{{categorySlug}}"
  }
}

docs {
  Updates category fields with PATCH.
}
