meta {
  name: Update Category PUT
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "faName": "Updated Category FA",
    "enName": "Updated Category EN",
    "description": "Updated category description",
    "slug": "{{categorySlug}}"
  }
}

docs {
  Updates category fields with PUT.
}
